# Copy this file to .env and fill in the values. Never commit .env.

# Port for the Node backend (Vite proxies /api to it during development)
PORT=3001

# ── SENDER: the Gmail account the server logs in to and sends FROM ──────────
# Needs a 16-character Gmail App Password (NOT your normal password).
# Create one at https://myaccount.google.com/apppasswords (2-Step Verification must be on).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sender@gmail.com
SMTP_PASS=
MAIL_FROM=sender@gmail.com

# ── RECEIVER: the inbox where feedback ARRIVES (no password needed) ─────────
MAIL_TO=receiver@example.com
